<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.efficient-quick-toggle"
          path="/org/gnome/shell/extensions/efficient-quick-toggle/">

    <!-- Order of the top row, left to right. Ids: dark-style, dnd,
         night-light (this extension's buttons), battery, screenshot,
         settings, lock, power (built-in items) and spacer (the flexible
         space that splits the row into a left and a right part). -->
    <key name="button-layout" type="as">
      <default>['battery', 'spacer', 'dark-style', 'dnd', 'night-light', 'screenshot', 'settings', 'lock', 'power']</default>
      <summary>Top row layout</summary>
      <description>Left-to-right order of the items in the quick settings top row.</description>
    </key>

    <!-- Items that are hidden, using the same ids as the layout. A hidden
         dark-style, dnd or night-light button gives its original toggle in
         the quick settings grid back. -->
    <key name="hidden-items" type="as">
      <default>[]</default>
      <summary>Hidden items</summary>
      <description>Ids of the top row items that are hidden.</description>
    </key>

    <!-- Written by the running extension so the preferences can show what it
         found; empty while the extension is not running. -->
    <key name="status" type="s">
      <default>''</default>
      <summary>Extension status</summary>
      <description>Status line written by the running extension, shown in the preferences.</description>
    </key>

    <!-- Slider thickness -->
    <key name="slider-thickness-enabled" type="b">
      <default>false</default>
      <summary>Customize slider thickness</summary>
      <description>When off, the volume and brightness sliders use the theme's default thickness.</description>
    </key>
    <key name="volume-slider-thickness" type="u">
      <range min="2" max="16"/>
      <default>6</default>
      <summary>Volume slider thickness</summary>
      <description>Thickness of the volume sliders (output and input) in pixels.</description>
    </key>
    <key name="brightness-slider-thickness" type="u">
      <range min="2" max="16"/>
      <default>6</default>
      <summary>Brightness slider thickness</summary>
      <description>Thickness of the brightness slider in pixels.</description>
    </key>
  </schema>
</schemalist>
